                    "main.c",
                    "-o",
                    "dist/main.hex"
                ]
            },
            "linux": {
                "command": "/opt/microchip/xc8/v3.10/bin/xc8-cc",
                "args": [
                    "-mcpu=18f14k50",
                    "-mdfp=/opt/microchip/mplabx/v6.30/packs/Microchip/PIC18F-K_DFP/1.15.303/xc8",
                    "main.c",
